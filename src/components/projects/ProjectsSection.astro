---
import ProjectPanel from "./ProjectPanel.astro";
import { projects } from "./projects.data";
---

<project-switcher class="switcher">
    <div class="list" role="tablist" aria-orientation="vertical" aria-label="Projects">
        {
            projects.map((project, index) => (
                <button
                    type="button"
                    class="tab"
                    role="tab"
                    id={`tab-${project.slug}`}
                    data-slug={project.slug}
                    aria-controls={`panel-${project.slug}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                >
                    <span class="tab-index">{project.index}</span>
                    <span class="tab-title">{project.title}</span>
                    <span class="tab-year">{project.year}</span>
                </button>
            ))
        }
    </div>

    <div class="stage">
        {
            projects.map((project, index) => (
                <ProjectPanel project={project} active={index === 0} />
            ))
        }
    </div>
</project-switcher>

<style>
    .switcher {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
        margin-top: 64px;
    }

    @media (min-width: 960px) {
        .switcher {
            grid-template-columns: minmax(240px, 320px) 1fr;
            gap: 64px;
            align-items: start;
        }
    }

    .list {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .tab {
        appearance: none;
        background: none;
        border: none;
        cursor: pointer;
        font-family: var(--fontSansSerif);
        text-align: left;
        color: var(--textTertiary);
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: baseline;
        gap: 12px;
        padding: 18px 0 18px 24px;
        transition: color 0.25s ease;
    }

    .tab:hover {
        color: var(--textSecondary);
    }

    .tab[aria-selected="true"] {
        color: var(--textPrimary);
    }

    .tab:focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
    }

    .tab-index {
        font-family: var(--fontTertiary);
        font-size: 11px;
        color: var(--textTertiary);
    }

    .tab[aria-selected="true"] .tab-index {
        color: var(--accent);
    }

    .tab-title {
        font-size: var(--fontSizeContent);
        font-weight: 500;
        letter-spacing: 0.2px;
    }

    .tab-year {
        font-family: var(--fontTertiary);
        font-size: 11px;
        color: var(--textTertiary);
    }

    .stage {
        display: grid;
    }

    @media (prefers-reduced-motion: reduce) {
        .tab {
            transition-duration: 1ms;
        }
    }
</style>

<script>
    import "./project-switcher";
</script>